# Application Environment Variables
PORT=8080
GIN_MODE=release

# Authentication
JWT_SECRET=replace_this_with_a_secure_random_string

# CORS — comma-separated list of allowed frontend origins
# Example: https://profhit.vercel.app,https://www.profhit.in
ALLOWED_ORIGINS=https://profhit.vercel.app

# Database Configuration (Set USE_SQLITE=false for PostgreSQL)
USE_SQLITE=false
# Prefer Render's internal PostgreSQL connection string, stored only in Render.
DATABASE_URL=
DB_HOST=localhost
DB_USER=profhit_user
DB_PASSWORD=
DB_NAME=profhit_db
DB_PORT=5432
DB_SSLMODE=require

# Razorpay Integration (For payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HyperVerge Integration (For KYC)
HYPERVERGE_API_URL=https://vrs.hyperverge.co/api/generateToken
HYPERVERGE_API_KEY=
HYPERVERGE_API_SECRET=
HYPERVERGE_WORKFLOW_ID=
HYPERVERGE_WEBHOOK_SECRET=

# Never enable demo accounts or simulator signing on a public deployment.
SEED_DEMO_DATA=false
BETA_MODE=false
APP_URL=https://profhit.vercel.app
GOOGLE_CLIENT_ID=
# Only trusted reverse-proxy CIDRs; empty ignores forwarded IP headers.
TRUSTED_PROXIES=
NEWS_API_KEY=
NEWS_PROVIDER_URL=https://gnews.io/api/v4/top-headlines
NEWS_CATEGORIES=general,sports,business,entertainment
# Your GNews plan must support this page size; four requests per refresh.
NEWS_PAGE_SIZE=50
NEWS_REFRESH_MINUTES=60
# Optional approved HTTPS RSS/Atom feeds, comma-separated; no invented fallback.
NEWS_RSS_FEEDS=
# Optional structured draft generation; every candidate still requires approval.
NEWS_AI_ENABLED=false
NEWS_AI_API_KEY=
NEWS_AI_MODEL=
NEWS_GENERATION_LIMIT=5
OPENWEATHER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=PROPHIT Team

# Base64-encoded 32-byte key for voucher storage; generate outside Git.
VOUCHER_ENCRYPTION_KEY=
