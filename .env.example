# Application Environment Variables
PORT=8080
GIN_MODE=release

# Authentication
JWT_SECRET=replace_this_with_a_secure_random_string

# CORS — comma-separated list of allowed frontend origins
# Example: https://profhit.vercel.app,https://www.profhit.in
ALLOWED_ORIGINS=https://profhit.vercel.app

# Database Configuration (Set USE_SQLITE=false for PostgreSQL)
USE_SQLITE=false
DB_HOST=localhost
DB_USER=profhit_user
DB_PASSWORD=profhit_password
DB_NAME=profhit_db
DB_PORT=5432

# Razorpay Integration (For payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# HyperVerge Integration (For KYC)
HYPERVERGE_API_URL=https://auth.hyperverge.co
HYPERVERGE_API_KEY=your_hyperverge_api_key
HYPERVERGE_API_SECRET=your_hyperverge_api_secret
HYPERVERGE_WORKFLOW_ID=your_hyperverge_workflow_id
HYPERVERGE_WEBHOOK_SECRET=your_hyperverge_webhook_secret
